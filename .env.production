# Production Environment Configuration for URL Shortener
# Copy this file to .env and update with your production values

# ==========================================
# SECURITY WARNING: 
# This file contains sensitive information!
# - Never commit this file to version control
# - Set proper file permissions (600)
# - Use strong, unique passwords
# ==========================================

# Application Environment
NODE_ENV=production
GO_ENV=production

# Domain Configuration
DOMAIN=yourdomain.com
BASE_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com
API_URL=https://api.yourdomain.com

# Database Configuration (PostgreSQL)
POSTGRES_DB=urlshortener_prod
POSTGRES_USER=urlshortener_prod
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123!
POSTGRES_PORT=5432
DATABASE_URL=postgres://urlshortener_prod:CHANGE_THIS_STRONG_PASSWORD_123!@postgres:5432/urlshortener_prod?sslmode=disable

# Redis Configuration
REDIS_PASSWORD=CHANGE_THIS_STRONG_REDIS_PASSWORD_456!
REDIS_PORT=6379
REDIS_URL=redis://:CHANGE_THIS_STRONG_REDIS_PASSWORD_456!@redis:6379/0

# JWT Security Configuration
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_SUPER_SECRET_JWT_KEY_MINIMUM_32_CHARACTERS_LONG_789!
SESSION_SECRET=CHANGE_THIS_SESSION_SECRET_KEY_012!

# Encryption Key (32 bytes for AES-256)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_THIS_32_BYTE_ENCRYPTION_KEY_345!

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_CREDENTIALS=true

# Server Ports
BACKEND_PORT=8080
FRONTEND_PORT=3000
HTTP_PORT=80
HTTPS_PORT=443

# SSL/TLS Configuration
SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem

# Data Storage Paths
DATA_PATH=/opt/urlshortener/data

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
AUTH_RATE_LIMIT_REQUESTS_PER_MINUTE=5
URL_CREATION_RATE_LIMIT_REQUESTS_PER_MINUTE=10

# Monitoring Configuration (Optional)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD_678!

# Email Configuration (for notifications - if implemented)
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=CHANGE_THIS_SMTP_PASSWORD_901!
SMTP_FROM=noreply@yourdomain.com

# External Service API Keys
GEOLOCATION_API_KEY=your_geolocation_api_key_here
ANALYTICS_API_KEY=your_analytics_api_key_here

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=your_s3_access_key
BACKUP_S3_SECRET_KEY=your_s3_secret_key

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=/var/log/urlshortener
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_QR_CODES=true
ENABLE_BULK_OPERATIONS=true
ENABLE_API_DOCS=true
ENABLE_METRICS=true

# Performance Configuration
MAX_REQUEST_SIZE=10MB
REQUEST_TIMEOUT=30s
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=300s
REDIS_POOL_SIZE=10
REDIS_MAX_RETRIES=3

# Security Configuration
BCRYPT_COST=12
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h  # 7 days
SESSION_TIMEOUT=24h
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=30m

# Application Limits
SHORT_CODE_LENGTH=6
MAX_CUSTOM_ALIAS_LENGTH=50
DEFAULT_EXPIRY_HOURS=8760  # 1 year
MAX_URLS_PER_USER=10000
MAX_CLICKS_PER_URL=1000000

# CDN Configuration (if using)
CDN_URL=https://cdn.yourdomain.com
CDN_API_KEY=your_cdn_api_key
CDN_ZONE_ID=your_cdn_zone_id

# Search Engine Configuration
ROBOTS_TXT_DISALLOW=false
SITEMAP_ENABLED=true
SEO_META_TITLE=URL Shortener - Professional Link Management
SEO_META_DESCRIPTION=Professional URL shortening service with analytics and QR codes

# Development/Debug (should be false in production)
DEBUG_MODE=false
ENABLE_PROFILER=false
ENABLE_SWAGGER_UI=true

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Service temporarily unavailable for maintenance

# ==========================================
# PRODUCTION DEPLOYMENT CHECKLIST:
# ==========================================
# [ ] Replace all CHANGE_THIS_* values with strong, unique passwords
# [ ] Set proper file permissions: chmod 600 .env
# [ ] Verify SSL certificates are in place
# [ ] Test database connectivity
# [ ] Test Redis connectivity  
# [ ] Verify CORS origins are correct
# [ ] Test rate limiting configuration
# [ ] Set up monitoring and alerting
# [ ] Configure automated backups
# [ ] Test disaster recovery procedures
# [ ] Review security headers and settings
# [ ] Verify log rotation is configured
# [ ] Test health check endpoints
# ==========================================