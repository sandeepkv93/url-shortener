	stats, err := suite.clickRepo.GetTopBrowsers(suite.ctx, suite.testURL.ID, 10)
	suite.NoError(err)
	suite.NotEmpty(stats)
	suite.Equal("chrome", stats[0].Browser)
	suite.Equal(int64(3), stats[0].Count)
}

func (suite *ComprehensiveTestSuite) TestClickRepository_GetTopReferers() {
	referers := []string{"google.com", "facebook.com", "google.com", "twitter.com", "google.com"}
	for _, referer := range referers {
		click := &domain.Click{
			ShortURLID: suite.testURL.ID,
			IPAddress:  "192.168.1.1",
			Referer:    referer,
			ClickedAt:  time.Now(),
		}
		err := suite.clickRepo.Create(suite.ctx, click)
		suite.NoError(err)
	}

	stats, err := suite.clickRepo.GetTopReferers(suite.ctx, suite.testURL.ID, 10)
	suite.NoError(err)
	suite.NotEmpty(stats)
	suite.Equal("google.com", stats[0].Referer)
	suite.Equal(int64(3), stats[0].Count)
}

func (suite *ComprehensiveTestSuite) TestClickRepository_GetRecentClicks() {
	// Create clicks with different attributes
	for i := 0; i < 5; i++ {
		click := &domain.Click{
			ShortURLID: suite.testURL.ID,
			IPAddress:  fmt.Sprintf("192.168.1.%d", i),
			Country:    fmt.Sprintf("Country%d", i),
			City:       fmt.Sprintf("City%d", i),
			Device:     "desktop",
			Browser:    "chrome",
			Referer:    "google.com",
			ClickedAt:  time.Now().Add(-time.Duration(i) * time.Minute),
		}
		err := suite.clickRepo.Create(suite.ctx, click)
		suite.NoError(err)
	}

	recentClicks, err := suite.clickRepo.GetRecentClicks(suite.ctx, suite.testURL.ID, 3)
	suite.NoError(err)
	suite.Len(recentClicks, 3)
	// Verify they're ordered by most recent first
	suite.Equal("Country0", recentClicks[0].Country)
}

func (suite *ComprehensiveTestSuite) TestClickRepository_GetUserStats() {
	// Create URLs and clicks for a user
	for i := 0; i < 3; i++ {
		url := &domain.ShortURL{
			ShortCode:   fmt.Sprintf("userstat%d", i),
			OriginalURL: fmt.Sprintf("https://userstat%d.com", i),
			UserID:      suite.testUser.ID,
			IsActive:    true,
			ClickCount:  int64(i * 5),
		}
		err := suite.urlRepo.Create(suite.ctx, url)
		suite.NoError(err)

		// Create clicks for each URL
		for j := 0; j < i+1; j++ {
			click := &domain.Click{
				ShortURLID: url.ID,
				IPAddress:  fmt.Sprintf("192.168.1.%d", j),
				ClickedAt:  time.Now().Add(-time.Duration(j) * 24 * time.Hour),
			}
			err = suite.clickRepo.Create(suite.ctx, click)
			suite.NoError(err)
		}
	}

	userStats, err := suite.clickRepo.GetUserStats(suite.ctx, suite.testUser.ID)
	suite.NoError(err)
	suite.NotNil(userStats)
	suite.Equal(suite.testUser.ID, userStats.UserID)
	suite.Equal(int64(4), userStats.TotalURLs) // 1 test + 3 additional
	suite.Equal(int64(6), userStats.TotalClicks) // 1+2+3 clicks
	suite.NotEmpty(userStats.ClicksByDate)
	suite.NotEmpty(userStats.TopURLs)
}

// Error handling tests
func (suite *ComprehensiveTestSuite) TestClickRepository_Create_Error() {
	// Test with invalid foreign key
	click := &domain.Click{
		ShortURLID: 9999, // Non-existent URL ID
		IPAddress:  "192.168.1.1",
		ClickedAt:  time.Now(),
	}
	err := suite.clickRepo.Create(suite.ctx, click)
	suite.Error(err)
}

func TestComprehensiveTestSuite(t *testing.T) {
	suite.Run(t, new(ComprehensiveTestSuite))
}