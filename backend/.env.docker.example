# Docker Environment Configuration
# This file contains Docker-optimized settings for containerized deployments

# Server Configuration - Docker
PORT=8080
HOST=0.0.0.0
GO_ENV=production

# Database Configuration - Docker (Using Docker service names)
DATABASE_URL=postgres://postgres:password@postgres:5432/urlshortener?sslmode=disable&pool_max_conns=50&pool_min_conns=10
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=urlshortener
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_MAX_CONNECTIONS=50
DATABASE_MAX_IDLE_CONNECTIONS=10

# Redis Configuration - Docker
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration - Docker
JWT_SECRET=docker-development-secret-change-in-production
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# Rate Limiting - Docker
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1h
RATE_LIMIT_ENABLED=true

# CORS Configuration - Docker (Allow all for development)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://frontend:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Request-ID

# External Services
GEOLOCATION_API_KEY=
GEOLOCATION_API_URL=https://api.ipgeolocation.io/ipgeo

# Application Configuration - Docker
BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
SHORT_CODE_LENGTH=8
DEFAULT_EXPIRY_DAYS=365
MAX_CUSTOM_ALIAS_LENGTH=50

# Security - Docker (Development-friendly)
BCRYPT_COST=10
MAX_REQUEST_SIZE=10MB
ENABLE_HTTPS=false
ENABLE_SECURITY_HEADERS=true
ENABLE_INPUT_VALIDATION=true
ENABLE_XSS_PROTECTION=true
ENABLE_CSRF_PROTECTION=true
ENABLE_SANITIZATION=true
ENABLE_SECURE_COOKIES=false
ENABLE_IP_RATE_LIMIT=true
IP_RATE_LIMIT_PER_MINUTE=100
BLOCK_SUSPICIOUS_URLS=false
ALLOWED_CONTENT_TYPES=application/json,application/x-www-form-urlencoded,multipart/form-data

# Logging - Docker
LOG_LEVEL=info
LOG_FORMAT=json

# Performance - Docker
ENABLE_COMPRESSION=true
COMPRESSION_LEVEL=6
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_CACHE_HEADERS=true
MAX_REQUEST_SIZE=10485760
SLOW_QUERY_THRESHOLD=100ms
ENABLE_QUERY_MONITORING=true
ENABLE_BATCH_OPERATIONS=true
BATCH_SIZE=100
MAX_CONCURRENT_QUERIES=50
CONNECTION_POOL_OPTIMIZATION=true

# Monitoring - Docker
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true
ENABLE_PERFORMANCE_ALERTS=false
METRICS_INTERVAL=30s
HEALTH_CHECK_INTERVAL=10s

# Alert Thresholds - Docker (Relaxed for development)
ALERT_SLOW_QUERY_THRESHOLD=500ms
ALERT_HIGH_MEMORY_THRESHOLD=1073741824
ALERT_HIGH_CPU_THRESHOLD=90.0
ALERT_ERROR_RATE_THRESHOLD=10.0
ALERT_RESPONSE_TIME_THRESHOLD=2s
ALERT_CACHE_HIT_RATE_THRESHOLD=50.0

# Cache Configuration - Docker
CACHE_TTL=1h
URL_CACHE_TTL=24h

# Production Deployment Settings
GRACEFUL_SHUTDOWN_TIMEOUT=30s
STARTUP_PROBE_DELAY=10s
READINESS_PROBE_DELAY=5s
LIVENESS_PROBE_DELAY=5s
ENABLE_AUTO_RESTART=true
ENABLE_HEALTH_ENDPOINTS=true
ENABLE_METRICS_ENDPOINTS=true
ENABLE_DEBUG_ENDPOINTS=true

# Database Migration Settings
ENABLE_AUTO_MIGRATE=true
MIGRATION_TIMEOUT=300s
BACKUP_BEFORE_MIGRATION=false

# Reverse Proxy Settings
TRUST_PROXY=false
PROXY_HEADER=X-Forwarded-For
REAL_IP_HEADER=X-Real-IP

# Error Tracking and Alerting
ERROR_TRACKING_ENABLED=true
ERROR_TRACKING_MAX_ERRORS=1000
ERROR_TRACKING_ALERT_THRESHOLD=50
ERROR_TRACKING_TIME_WINDOW=1h
ERROR_TRACKING_CRITICAL_THRESHOLD=10
ERROR_TRACKING_RETENTION_PERIOD=24h

# Container specific
POD_NAME=url-shortener-backend
POD_NAMESPACE=default
SERVICE_NAME=url-shortener-api
CLUSTER_NAME=docker-compose
ENABLE_PPROF=true
PPROF_PORT=6060

# Docker Compose Health Checks
HEALTH_CHECK_ENDPOINT=/health
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=60s