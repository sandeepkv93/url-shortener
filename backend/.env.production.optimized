# Production Optimized Environment Configuration
# This configuration file contains optimized settings for high-performance production deployment

# Application Environment
GO_ENV=production
NODE_ENV=production

# Server Configuration - Optimized for high throughput
PORT=8080
HOST=0.0.0.0
TLS_PORT=8443

# Database Configuration - Optimized connection pooling
DATABASE_URL=postgres://urlshortener:${DATABASE_PASSWORD}@postgres:5432/urlshortener?sslmode=require&pool_max_conns=25&pool_min_conns=5
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=urlshortener
DATABASE_USER=urlshortener
DATABASE_PASSWORD=${DATABASE_PASSWORD}
DATABASE_MAX_CONNECTIONS=25
DATABASE_MAX_IDLE_CONNECTIONS=10
DATABASE_CONN_MAX_LIFETIME=1h
DATABASE_CONN_MAX_IDLE_TIME=15m
DATABASE_QUERY_TIMEOUT=30s
DATABASE_PING_INTERVAL=1m

# Redis Configuration - Optimized for caching
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_DB=0
REDIS_POOL_SIZE=50
REDIS_MIN_IDLE_CONNS=10
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_TIMEOUT=4s
REDIS_IDLE_TIMEOUT=5m

# JWT Configuration
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# Rate Limiting - Production optimized
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_BURST=200

# Security Configuration
BCRYPT_COST=12
MAX_REQUEST_SIZE=32MB
ENABLE_HTTPS=true
ENABLE_SECURITY_HEADERS=true
ENABLE_INPUT_VALIDATION=true
ENABLE_XSS_PROTECTION=true
ENABLE_CSRF_PROTECTION=true
ENABLE_SANITIZATION=true
ENABLE_SECURE_COOKIES=true
ENABLE_IP_RATE_LIMIT=true
IP_RATE_LIMIT_PER_MINUTE=60

# SSL/TLS Configuration
TLS_ENABLED=true
TLS_CERT_FILE=/etc/ssl/certs/url-shortener.crt
TLS_KEY_FILE=/etc/ssl/private/url-shortener.key
TLS_MIN_VERSION=1.2

# Reverse Proxy Configuration
TRUST_PROXY=true
PROXY_HEADER=X-Forwarded-For
REAL_IP_HEADER=X-Real-IP
FORWARDED_PROTO_HEADER=X-Forwarded-Proto

# Application Configuration
BASE_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com
SHORT_CODE_LENGTH=6
DEFAULT_EXPIRY_DAYS=365
MAX_CUSTOM_ALIAS_LENGTH=50

# Logging Configuration - Optimized for production
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=file
LOG_FILE=/var/log/url-shortener/app.log
LOG_MAX_SIZE=100MB
LOG_MAX_FILES=10
LOG_RETENTION_DAYS=30
ENABLE_ASYNC_LOGGING=true
LOG_BUFFER_SIZE=10000
LOG_FLUSH_INTERVAL=5s
ENABLE_PERFORMANCE_LOGS=true
SLOW_REQUEST_THRESHOLD=1s

# Cache Configuration - Optimized for performance
CACHE_DEFAULT_TTL=1h
CACHE_URL_TTL=24h
CACHE_USER_TTL=15m
CACHE_ANALYTICS_TTL=5m
ENABLE_CACHE_COMPRESSION=true
CACHE_COMPRESSION_THRESHOLD=1KB

# Performance Configuration - Production optimized
PERFORMANCE_MONITORING_ENABLED=true
METRICS_INTERVAL=30s
ENABLE_SYSTEM_METRICS=true
ENABLE_RUNTIME_METRICS=true
ENABLE_CUSTOM_METRICS=true

# Production Optimizations
PRODUCTION_GRACEFUL_SHUTDOWN_TIMEOUT=30s
PRODUCTION_STARTUP_PROBE_DELAY=10s
PRODUCTION_READINESS_PROBE_DELAY=5s
PRODUCTION_LIVENESS_PROBE_DELAY=15s
PRODUCTION_ENABLE_AUTO_RESTART=true
PRODUCTION_ENABLE_HEALTH_ENDPOINTS=true
PRODUCTION_ENABLE_METRICS_ENDPOINTS=true
PRODUCTION_ENABLE_DEBUG_ENDPOINTS=false

# Server Optimizations
SERVER_MAX_CONNECTIONS=10000
SERVER_MAX_IDLE_CONNECTIONS=1000
SERVER_CONNECTION_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=120s
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_READ_HEADER_TIMEOUT=10s
SERVER_KEEP_ALIVE=true
SERVER_KEEP_ALIVE_TIMEOUT=15s
SERVER_READ_BUFFER_SIZE=32KB
SERVER_WRITE_BUFFER_SIZE=32KB
SERVER_MAX_HEADER_BYTES=64KB
SERVER_ENABLE_COMPRESSION=true
SERVER_COMPRESSION_LEVEL=6
SERVER_COMPRESSION_THRESHOLD=1KB
SERVER_MAX_REQUEST_SIZE=32MB
SERVER_MAX_MULTIPART_MEMORY=32MB

# Runtime Optimizations
RUNTIME_GC_TARGET_PERCENTAGE=100
RUNTIME_MAX_GC_PAUSE_TARGET=10ms
RUNTIME_ENABLE_GC_TRACE=false
RUNTIME_WORKER_POOL_SIZE=16
RUNTIME_QUEUE_SIZE=10000
RUNTIME_MEMORY_BALLAST_SIZE=100MB
RUNTIME_ENABLE_MEMORY_BALLAST=true

# Memory Optimizations
MEMORY_MAX_USAGE=2GB
MEMORY_WARNING_THRESHOLD=0.8
MEMORY_PANIC_THRESHOLD=0.95
MEMORY_ENABLE_BUFFER_POOLS=true
MEMORY_BUFFER_POOL_SIZE=1000
MEMORY_MAX_BUFFER_SIZE=64KB
MEMORY_ENABLE_OBJECT_POOLS=true
MEMORY_OBJECT_POOL_SIZE=500
MEMORY_CHECK_INTERVAL=30s
MEMORY_ENABLE_PROFILING=false

# Monitoring Optimizations
MONITORING_HEALTH_CHECK_INTERVAL=30s
MONITORING_HEALTH_CHECK_TIMEOUT=5s
MONITORING_ENABLE_PROFILING=false
MONITORING_PROFILING_INTERVAL=10m
MONITORING_ENABLE_CPU_PROFILING=false
MONITORING_ENABLE_MEMORY_PROFILING=false
MONITORING_ENABLE_TRACING=true
MONITORING_TRACING_SAMPLE_RATE=0.1
MONITORING_TRACE_EXPORTER=jaeger

# Resource Optimizations
RESOURCES_CPU_QUOTA=8
RESOURCES_CPU_SHARES=1024
RESOURCES_CPU_THROTTLE_THRESHOLD=0.9
RESOURCES_NETWORK_BANDWIDTH_LIMIT=1GB
RESOURCES_MAX_CONCURRENT_REQUESTS=10000
RESOURCES_MAX_FILE_DESCRIPTORS=65536
RESOURCES_DISK_IO_THRESHOLD=100MB
RESOURCES_MAX_DISK_USAGE=10GB

# External Services
GEOLOCATION_API_KEY=${GEOLOCATION_API_KEY}
GEOLOCATION_API_URL=https://api.ipgeolocation.io/ipgeo

# Container Configuration
CONTAINER_POD_NAME=${POD_NAME}
CONTAINER_POD_NAMESPACE=${POD_NAMESPACE}
CONTAINER_SERVICE_NAME=url-shortener
CONTAINER_CLUSTER_NAME=${CLUSTER_NAME}
CONTAINER_NODE_NAME=${NODE_NAME}
CONTAINER_ENABLE_PPROF=false
CONTAINER_PPROF_PORT=6060

# Migration Configuration
MIGRATION_ENABLE_AUTO_MIGRATE=true
MIGRATION_TIMEOUT=5m
MIGRATION_BACKUP_BEFORE_MIGRATION=true
MIGRATION_PATH=/app/migrations
MIGRATION_MAX_RETRIES=3

# Development/Debug (disabled in production)
DEBUG=false
PPROF_ENABLED=false
ENABLE_DEBUG_ENDPOINTS=false
VERBOSE_LOGGING=false

# Health Check Configuration
HEALTH_CHECK_DATABASE=true
HEALTH_CHECK_REDIS=true
HEALTH_CHECK_EXTERNAL_SERVICES=true
HEALTH_CHECK_TIMEOUT=5s

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL=6h
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true

# Feature Flags
FEATURE_QR_CODE_GENERATION=true
FEATURE_ANALYTICS=true
FEATURE_CUSTOM_DOMAINS=true
FEATURE_BULK_OPERATIONS=true
FEATURE_API_RATE_LIMITING=true

# Alerting Configuration
ALERT_EMAIL_ENABLED=true
ALERT_SLACK_ENABLED=true
ALERT_WEBHOOK_ENABLED=true
ALERT_CPU_THRESHOLD=80
ALERT_MEMORY_THRESHOLD=85
ALERT_DISK_THRESHOLD=90
ALERT_ERROR_RATE_THRESHOLD=5

# Metrics Export
METRICS_EXPORT_ENABLED=true
METRICS_EXPORT_INTERVAL=1m
METRICS_EXPORT_FORMAT=prometheus
METRICS_EXPORT_ENDPOINT=/metrics

# Application Insights
APP_INSIGHTS_ENABLED=true
APP_INSIGHTS_SAMPLE_RATE=1.0
APP_INSIGHTS_INSTRUMENTATION_KEY=${APP_INSIGHTS_KEY}

# Load Balancer Health Check
LB_HEALTH_CHECK_PATH=/health
LB_READINESS_CHECK_PATH=/ready
LB_LIVENESS_CHECK_PATH=/live