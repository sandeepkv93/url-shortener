# Staging Environment Configuration
# This file contains staging-optimized settings that mirror production but with relaxed security for testing

# Server Configuration - Staging
PORT=8080
HOST=0.0.0.0
GO_ENV=staging

# Database Configuration - Staging (Use connection pooling)
DATABASE_URL=postgres://username:password@staging-postgres:5432/urlshortener?sslmode=require&pool_max_conns=30&pool_min_conns=5
DATABASE_HOST=staging-postgres
DATABASE_PORT=5432
DATABASE_NAME=urlshortener
DATABASE_USER=username
DATABASE_PASSWORD=change-me-in-staging
DATABASE_MAX_CONNECTIONS=30
DATABASE_MAX_IDLE_CONNECTIONS=8

# Redis Configuration - Staging
REDIS_URL=redis://staging-redis:6379
REDIS_HOST=staging-redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-in-staging
REDIS_DB=0

# JWT Configuration - Staging (Moderate security)
JWT_SECRET=change-me-to-a-long-secret-for-staging-environment-testing
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=5d

# Rate Limiting - Staging (Less restrictive than production)
RATE_LIMIT_REQUESTS=75
RATE_LIMIT_WINDOW=1h
RATE_LIMIT_ENABLED=true

# CORS Configuration - Staging (Allow staging domains)
CORS_ALLOWED_ORIGINS=https://staging.yourdomain.com,https://staging-api.yourdomain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Request-ID

# External Services
GEOLOCATION_API_KEY=your-staging-geolocation-api-key
GEOLOCATION_API_URL=https://api.ipgeolocation.io/ipgeo

# Application Configuration - Staging
BASE_URL=https://staging-api.yourdomain.com
FRONTEND_URL=https://staging.yourdomain.com
SHORT_CODE_LENGTH=8
DEFAULT_EXPIRY_DAYS=365
MAX_CUSTOM_ALIAS_LENGTH=50

# Security - Staging (Enhanced but not as strict as production)
BCRYPT_COST=12
MAX_REQUEST_SIZE=8MB
ENABLE_HTTPS=true
ENABLE_SECURITY_HEADERS=true
ENABLE_INPUT_VALIDATION=true
ENABLE_XSS_PROTECTION=true
ENABLE_CSRF_PROTECTION=true
ENABLE_SANITIZATION=true
ENABLE_SECURE_COOKIES=true
ENABLE_IP_RATE_LIMIT=true
IP_RATE_LIMIT_PER_MINUTE=50
BLOCK_SUSPICIOUS_URLS=true
ALLOWED_CONTENT_TYPES=application/json,application/x-www-form-urlencoded
CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self' 'unsafe-inline'
CSP_STYLE_SRC='self' 'unsafe-inline'
CSP_IMG_SRC='self' data: https:

# Logging - Staging (More verbose than production)
LOG_LEVEL=info
LOG_FORMAT=json

# Performance - Staging (Good performance but not as aggressive as production)
ENABLE_COMPRESSION=true
COMPRESSION_LEVEL=6
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_CACHE_HEADERS=true
MAX_REQUEST_SIZE=8388608
SLOW_QUERY_THRESHOLD=100ms
ENABLE_QUERY_MONITORING=true
ENABLE_BATCH_OPERATIONS=true
BATCH_SIZE=150
MAX_CONCURRENT_QUERIES=75
CONNECTION_POOL_OPTIMIZATION=true

# Monitoring - Staging (Comprehensive monitoring like production)
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true
ENABLE_PERFORMANCE_ALERTS=true
METRICS_INTERVAL=30s
HEALTH_CHECK_INTERVAL=10s

# Alert Thresholds - Staging (Slightly relaxed from production)
ALERT_SLOW_QUERY_THRESHOLD=200ms
ALERT_HIGH_MEMORY_THRESHOLD=1610612736
ALERT_HIGH_CPU_THRESHOLD=75.0
ALERT_ERROR_RATE_THRESHOLD=3.0
ALERT_RESPONSE_TIME_THRESHOLD=750ms
ALERT_CACHE_HIT_RATE_THRESHOLD=75.0

# Cache Configuration - Staging
CACHE_TTL=2h
URL_CACHE_TTL=24h

# Production Deployment Settings
GRACEFUL_SHUTDOWN_TIMEOUT=30s
STARTUP_PROBE_DELAY=10s
READINESS_PROBE_DELAY=5s
LIVENESS_PROBE_DELAY=5s
ENABLE_AUTO_RESTART=true
ENABLE_HEALTH_ENDPOINTS=true
ENABLE_METRICS_ENDPOINTS=true
ENABLE_DEBUG_ENDPOINTS=true

# SSL/TLS Configuration
TLS_CERT_FILE=/etc/ssl/certs/staging-tls.crt
TLS_KEY_FILE=/etc/ssl/private/staging-tls.key
TLS_MIN_VERSION=1.2
TLS_CIPHER_SUITES=TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305
TLS_ENABLE_HTTP2=true

# Database Migration Settings
ENABLE_AUTO_MIGRATE=true
MIGRATION_TIMEOUT=300s
BACKUP_BEFORE_MIGRATION=true

# Reverse Proxy Settings
TRUST_PROXY=true
PROXY_HEADER=X-Forwarded-For
REAL_IP_HEADER=X-Real-IP

# Error Tracking and Alerting
ERROR_TRACKING_ENABLED=true
ERROR_TRACKING_MAX_ERRORS=5000
ERROR_TRACKING_ALERT_THRESHOLD=50
ERROR_TRACKING_TIME_WINDOW=1h
ERROR_TRACKING_CRITICAL_THRESHOLD=10
ERROR_TRACKING_RETENTION_PERIOD=72h

# Container and Kubernetes specific
POD_NAME=${HOSTNAME}
POD_NAMESPACE=url-shortener-staging
SERVICE_NAME=url-shortener-api
CLUSTER_NAME=staging
ENABLE_PPROF=true
PPROF_PORT=6060

# External integrations (Staging)
SENTRY_DSN=https://your-staging-sentry-dsn@sentry.io/project-id
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/staging/webhook
EMAIL_SMTP_HOST=smtp.staging.yourdomain.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=noreply@staging.yourdomain.com
EMAIL_SMTP_PASSWORD=your-staging-smtp-password
EMAIL_FROM_ADDRESS=noreply@staging.yourdomain.com