# Production Environment Configuration
# This file contains production-optimized settings for the URL Shortener service

# Server Configuration - Production
PORT=8080
HOST=0.0.0.0
GO_ENV=production

# Database Configuration - Production (Use connection pooling and SSL)
DATABASE_URL=postgres://username:password@prod-postgres:5432/urlshortener?sslmode=require&pool_max_conns=50&pool_min_conns=10
DATABASE_HOST=prod-postgres
DATABASE_PORT=5432
DATABASE_NAME=urlshortener
DATABASE_USER=username
DATABASE_PASSWORD=change-me-in-production
DATABASE_MAX_CONNECTIONS=50
DATABASE_MAX_IDLE_CONNECTIONS=10

# Redis Configuration - Production
REDIS_URL=redis://prod-redis:6379
REDIS_HOST=prod-redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-in-production
REDIS_DB=0

# JWT Configuration - Production (Strong secrets and shorter expiry)
JWT_SECRET=change-me-to-a-very-long-random-secret-in-production-at-least-64-characters
JWT_EXPIRY=12h
JWT_REFRESH_EXPIRY=3d

# Rate Limiting - Production (More restrictive)
RATE_LIMIT_REQUESTS=50
RATE_LIMIT_WINDOW=1h
RATE_LIMIT_ENABLED=true

# CORS Configuration - Production (Specific domains only)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Request-ID

# External Services
GEOLOCATION_API_KEY=your-production-geolocation-api-key
GEOLOCATION_API_URL=https://api.ipgeolocation.io/ipgeo

# Application Configuration - Production
BASE_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com
SHORT_CODE_LENGTH=8
DEFAULT_EXPIRY_DAYS=365
MAX_CUSTOM_ALIAS_LENGTH=50

# Security - Production (Enhanced security settings)
BCRYPT_COST=14
MAX_REQUEST_SIZE=5MB
ENABLE_HTTPS=true
ENABLE_SECURITY_HEADERS=true
ENABLE_INPUT_VALIDATION=true
ENABLE_XSS_PROTECTION=true
ENABLE_CSRF_PROTECTION=true
ENABLE_SANITIZATION=true
ENABLE_SECURE_COOKIES=true
ENABLE_IP_RATE_LIMIT=true
IP_RATE_LIMIT_PER_MINUTE=30
BLOCK_SUSPICIOUS_URLS=true
ALLOWED_CONTENT_TYPES=application/json,application/x-www-form-urlencoded
CSP_DEFAULT_SRC='self'
CSP_SCRIPT_SRC='self'
CSP_STYLE_SRC='self'
CSP_IMG_SRC='self' data: https:

# Logging - Production (Structured logging)
LOG_LEVEL=warn
LOG_FORMAT=json

# Performance - Production (Optimized for high throughput)
ENABLE_COMPRESSION=true
COMPRESSION_LEVEL=9
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_CACHE_HEADERS=true
MAX_REQUEST_SIZE=5242880
SLOW_QUERY_THRESHOLD=50ms
ENABLE_QUERY_MONITORING=true
ENABLE_BATCH_OPERATIONS=true
BATCH_SIZE=200
MAX_CONCURRENT_QUERIES=100
CONNECTION_POOL_OPTIMIZATION=true

# Monitoring - Production (Comprehensive monitoring)
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true
ENABLE_PERFORMANCE_ALERTS=true
METRICS_INTERVAL=15s
HEALTH_CHECK_INTERVAL=5s

# Alert Thresholds - Production (Aggressive monitoring)
ALERT_SLOW_QUERY_THRESHOLD=100ms
ALERT_HIGH_MEMORY_THRESHOLD=2147483648
ALERT_HIGH_CPU_THRESHOLD=70.0
ALERT_ERROR_RATE_THRESHOLD=2.0
ALERT_RESPONSE_TIME_THRESHOLD=500ms
ALERT_CACHE_HIT_RATE_THRESHOLD=80.0

# Cache Configuration - Production (Longer TTL for better performance)
CACHE_TTL=4h
URL_CACHE_TTL=48h

# Production Deployment Settings
GRACEFUL_SHUTDOWN_TIMEOUT=30s
STARTUP_PROBE_DELAY=10s
READINESS_PROBE_DELAY=5s
LIVENESS_PROBE_DELAY=5s

# SSL/TLS Configuration
TLS_CERT_FILE=/etc/ssl/certs/tls.crt
TLS_KEY_FILE=/etc/ssl/private/tls.key
TLS_MIN_VERSION=1.2
TLS_CIPHER_SUITES=TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305,TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256

# Database Migration Settings
ENABLE_AUTO_MIGRATE=false
MIGRATION_TIMEOUT=300s
BACKUP_BEFORE_MIGRATION=true

# Reverse Proxy Settings
TRUST_PROXY=true
PROXY_HEADER=X-Forwarded-For
REAL_IP_HEADER=X-Real-IP

# Error Tracking and Alerting
ERROR_TRACKING_ENABLED=true
ERROR_TRACKING_MAX_ERRORS=10000
ERROR_TRACKING_ALERT_THRESHOLD=100
ERROR_TRACKING_TIME_WINDOW=1h
ERROR_TRACKING_CRITICAL_THRESHOLD=10
ERROR_TRACKING_RETENTION_PERIOD=168h

# Container and Kubernetes specific
POD_NAME=${HOSTNAME}
POD_NAMESPACE=url-shortener
SERVICE_NAME=url-shortener-api
CLUSTER_NAME=production

# External integrations (Production)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook
EMAIL_SMTP_HOST=smtp.yourdomain.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=noreply@yourdomain.com
EMAIL_SMTP_PASSWORD=your-smtp-password
EMAIL_FROM_ADDRESS=noreply@yourdomain.com